#VRML_SIM R2023a utf8


EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/master/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/master/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/master/projects/appearances/protos/CarpetFibers.proto"
EXTERNPROTO "../protos/Rosbot.proto"

WorldInfo {
  info [
    "CleverHive world with a ROSbot"
  ]
  title "CleverHive"
  lineScale 0.15
  gravity 1.62
}
Viewpoint {
  orientation 0.247297 -0.168564 -0.954165 -1.93179
  position 6.40263 -11.291 6.82282
  follow "Rosbot"
}
Background {
  skyColor [
    0 0 0
  ]
  backUrl "./assets/skybox.png"
  bottomUrl "./assets/skybox.png"
  frontUrl "./assets/skybox.png"
  leftUrl "./assets/skybox.png"
  rightUrl "./assets/skybox.png"
  topUrl "./assets/skybox.png"
  luminosity 0
}
PointLight {
  attenuation 0 0 1
  intensity 200
  location 100 0 25
  radius 10000
}
Floor {
  translation 1.75 -0.75 0
  size 5 5
  tileSize 1 1
}
Rosbot {
  name "rosbot"
  translation 3 -2 0
  controller "<extern>"
  controllerArgs [
    ""
  ]
}
